# Diagnóstico Comercial Voga.IA - Variáveis de Ambiente

# OpenAI API (opcional - para modelos premium)
# OPENAI_API_KEY=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

# Configurações do CrewAI
CREWAI_VERBOSE=true
CREWAI_MEMORY=true

# Configurações de saída
OUTPUT_FORMAT=markdown
GENERATE_EXCEL=true
GENERATE_DASHBOARD_SPECS=true

# Configurações de monitoramento
