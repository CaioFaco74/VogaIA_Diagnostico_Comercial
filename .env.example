# Diagnóstico Comercial Voga.IA - Variáveis de Ambiente

# OpenAI API (obrigatório para usar modelos OpenAI)
# IMPORTANTE: NUNCA commite sua chave real no Git!
# Obtenha sua chave em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-sua-chave-aqui-substitua-por-chave-real

# Modelo OpenAI a ser utilizado (opcional - padrão: gpt-4o-mini)
OPENAI_MODEL_NAME=gpt-4o-mini

# Configurações do CrewAI
CREWAI_VERBOSE=true
CREWAI_MEMORY=true

# Configurações de saída
OUTPUT_FORMAT=markdown
GENERATE_EXCEL=true
GENERATE_DASHBOARD_SPECS=true

# Configurações de monitoramento
ENABLE_ALERTS=true
ALERT_EMAIL=admin@empresa.com

# Configurações de benchmark
DEFAULT_SECTOR=geral
DEFAULT_COMPANY_SIZE=media

# Debug e logs
DEBUG_MODE=false
LOG_LEVEL=INFO
